# Flask
SECRET_KEY=your-secret-key-change-this-to-something-long-and-random

# Google OAuth (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Scan trigger secret (GitHub Actions uses this to call /api/trigger-scan)
SCAN_SECRET=your-scan-secret-change-this

# App URL (used by GitHub Actions to call your deployed app)
APP_URL=https://your-app.railway.app

# Database (SQLite by default, change for production)
DATABASE_URL=sqlite:///emailscanner.db
